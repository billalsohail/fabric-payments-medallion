/// =====================================================================================
/// fact_dispute — grain: one dispute
///
/// This table is the role-playing dimension case, and it is the one part of the model where a
/// measure that looks right is most likely to be wrong. Two things have to be held at once:
///
/// 1. **Two dates, one dimension.** `raised_date_sk` and `resolved_date_sk` both point at
///    `dim_date`. Only one relationship can be active, so `rel_fd_raised_date` is active and
///    `rel_fd_resolved_date` is not — every date slicer therefore means *raised* unless a measure
///    says otherwise with `USERELATIONSHIP`. That default is the right way round because
///    raised-date counts are final the moment they happen, whereas resolved-date counts restate
///    as open disputes close; a dashboard whose default date role restates last month's numbers
///    on every refresh is a dashboard nobody trusts.
///
/// 2. **`resolved_date_sk` is -1, not NULL, while a dispute is open.** It is `NOT NULL` in the
///    DDL and the loader COALESCEs to the unknown member. So a measure that switches on the
///    resolved role and does nothing else counts **every open dispute** against date row -1, and
///    row -1 carries a real date (see dim_date.tmdl) — so those disputes do not even land
///    somewhere visibly wrong, they land on a real day and inflate it. Every measure below that
///    uses the resolved role filters `is_open = 0` itself rather than trusting the join.
///
/// The alternative design — a `dim_resolved_date` view aliasing `dim_date` — was rejected: it
/// gives the report two date hierarchies where only one can be the marked date table, and on
/// Fabric it is a hand-maintained object that drifts. See docs/design-decisions.md.
/// =====================================================================================
table fact_dispute
	lineageTag: 7fba4f2f-74c5-5747-9787-bcae2f1ef86f

	column dispute_id
		dataType: string
		summarizeBy: none
		sourceColumn: dispute_id

	/// Carried so a dispute can be traced to its transaction, but there is deliberately **no
	/// relationship** between the two facts — and no FK either, per
	/// `src/warehouse/ddl/04_constraints.sql`, which says a fact-to-fact FK "would assert that
	/// every dispute's transaction is present in the warehouse, and that is exactly the condition
	/// the silver `referential` DQ rule tests and quarantines on."
	///
	/// A model relationship would be worse than the FK: a many-to-one from dispute to transaction
	/// makes `[Disputes Raised]` filterable by transaction attributes and therefore silently drops
	/// every dispute whose transaction was quarantined. The two facts are related through their
	/// shared conformed dimensions — merchant, account, date, currency — which is how a star is
	/// supposed to relate two facts.
	column transaction_id
		dataType: string
		summarizeBy: none
		sourceColumn: transaction_id

	column raised_date_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: raised_date_sk

	column resolved_date_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: resolved_date_sk

	column account_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: account_sk

	column merchant_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: merchant_sk

	column currency_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: currency_sk

	/// For the security predicate, not for slicing — same reasoning as on fact_transaction, and
	/// present on both facts because a control applied to one of two facts at the same
	/// sensitivity is not a control.
	column account_region
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: account_region

	column raised_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: raised_date

	/// NULL while open — unlike `resolved_date_sk`, which is -1. The date column is honest about
	/// not knowing and the key column cannot be, because a NULL key would drop the row from every
	/// sliced measure. Worth keeping visible precisely so the asymmetry is discoverable by anyone
	/// debugging a resolved-date number.
	column resolved_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: resolved_date

	/// NULL while open, so `AVERAGE` over it already excludes open disputes. `[Dispute Resolution
	/// Days]` filters `is_open = 0` anyway — belt and braces, and the filter is what makes the
	/// intent readable rather than dependent on knowing that AVERAGE ignores blanks.
	column resolution_days
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: resolution_days

	/// Transaction currency: not summable across currencies, same as fact_transaction[amount_minor].
	column disputed_amount_minor
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: disputed_amount_minor

	column disputed_amount_gbp_minor
		dataType: int64
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		summarizeBy: none
		sourceColumn: disputed_amount_gbp_minor

	/// The four outcome flags, smallint for the same summability reason as on fact_transaction.
	/// They are mutually exclusive and exhaustive: open + won + lost + withdrawn = 1 on every row,
	/// which is what makes `[Dispute Win Rate]`'s denominator constructible as a sum of flags
	/// rather than needing a status-string filter.
	column is_open
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: is_open

	column is_won
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: is_won

	column is_lost
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: is_lost

	column is_withdrawn
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: is_withdrawn

	column dispute_status
		dataType: string
		summarizeBy: none
		sourceColumn: dispute_status

	column reason_code
		dataType: string
		summarizeBy: none
		sourceColumn: reason_code

	column load_batch_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: load_batch_id

	column loaded_ts
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy hh:nn:ss
		summarizeBy: none
		sourceColumn: loaded_ts

	/// -------------------------------------------------------------------------------------
	/// Raised role — the active relationship, so no USERELATIONSHIP needed
	/// -------------------------------------------------------------------------------------
	measure 'Disputes Raised' = COUNTROWS(fact_dispute)
		formatString: #,0
		displayFolder: Disputes

	measure 'Disputes Open' = SUM(fact_dispute[is_open])
		formatString: #,0
		displayFolder: Disputes

	measure 'Disputes Won' = SUM(fact_dispute[is_won])
		formatString: #,0
		displayFolder: Disputes

	measure 'Disputes Lost' = SUM(fact_dispute[is_lost])
		formatString: #,0
		displayFolder: Disputes

	measure 'Disputed Volume (GBP)' = SUM(fact_dispute[disputed_amount_gbp_minor])
		formatString: \£#,0.00;(\£#,0.00);\£#,0.00
		displayFolder: Disputes

	/// Won over *decided*, not won over raised. An open dispute has not been lost, and putting it
	/// in the denominator reports a win rate that climbs for a month afterwards purely as
	/// disputes close — the denominator moving is indistinguishable from performance improving.
	/// `is_won + is_lost` is the decided count; withdrawn is excluded from both sides because a
	/// withdrawal is not an outcome the disputes team competed for.
	measure 'Dispute Win Rate' = ```
			DIVIDE(
			    [Disputes Won],
			    [Disputes Won] + [Disputes Lost]
			)
			```
		formatString: 0.00%
		displayFolder: Disputes

	/// -------------------------------------------------------------------------------------
	/// Resolved role — USERELATIONSHIP plus an explicit is_open filter
	/// -------------------------------------------------------------------------------------
	/// This is the pair `src/warehouse/ddl/04_constraints.sql` promises when it says the two date
	/// FKs exist so "the semantic model does the role-playing with two inactive relationships plus
	/// USERELATIONSHIP in the measures".
	///
	/// `is_open = 0` is not redundant. Without it, every open dispute joins through
	/// `resolved_date_sk = -1` to the unknown member, and -1 carries a real date — so a resolved-
	/// date trend would show a spike on that one day equal to the entire open backlog. The
	/// USERELATIONSHIP and the filter are a single idea and neither is correct alone.
	measure 'Disputes Resolved' = ```
			CALCULATE(
			    COUNTROWS(fact_dispute),
			    USERELATIONSHIP(fact_dispute[resolved_date_sk], dim_date[date_sk]),
			    fact_dispute[is_open] = 0
			)
			```
		formatString: #,0
		displayFolder: Disputes (resolved date)

	/// Mean days from raised to resolved, attributed to the period the dispute was **resolved** in
	/// — which is the operationally useful attribution: it answers "how fast is the team closing
	/// things now", whereas the raised-date version answers "how fast were things raised in March
	/// eventually closed", a number that is not knowable until the last one closes.
	measure 'Dispute Resolution Days' = ```
			CALCULATE(
			    AVERAGE(fact_dispute[resolution_days]),
			    USERELATIONSHIP(fact_dispute[resolved_date_sk], dim_date[date_sk]),
			    fact_dispute[is_open] = 0
			)
			```
		formatString: #,0.0
		displayFolder: Disputes (resolved date)

	/// -------------------------------------------------------------------------------------
	/// Chargeback rate — in basis points, and the measure that crosses both facts
	/// -------------------------------------------------------------------------------------
	/// bps rather than a percentage because the honest number is around 5-to-50 per 10,000 and
	/// "0.05%" in a table of two-decimal percentages renders as 0.05 next to an authorisation rate
	/// of 94.20 — same column, three orders of magnitude apart, and a reader compares them.
	/// Payments reports quote chargeback rates in bps for exactly this reason, and the card scheme
	/// thresholds that matter (Visa VDMP, Mastercard ECP) are themselves expressed in bps.
	///
	/// Numerator and denominator come from **different fact tables**, which works only because
	/// both are filtered by the same conformed dimensions — `dim_merchant` and `dim_date` here.
	/// The two counts are therefore at the same grain of *filter context* even though the tables
	/// are at different grains of row. That is the payoff of conforming the dimensions rather than
	/// putting dispute columns on fact_transaction.
	///
	/// The caveat this measure cannot fix: the dispute and the transaction it disputes fall in
	/// different periods (0-90 days apart, per the generator), so a single month's ratio divides
	/// disputes raised in March by transactions attempted in March — not by the transactions those
	/// disputes relate to. That is how the schemes compute it and how the industry quotes it, and
	/// it is stable over a quarter and noisy over a week. A cohort-accurate version needs the
	/// transaction's own date, which needs the fact-to-fact relationship this model deliberately
	/// does not have.
	measure 'Chargeback Rate (bps)' = ```
			DIVIDE(
			    [Disputes Raised],
			    [Attempts]
			) * 10000
			```
		formatString: #,0.0
		displayFolder: Disputes

	/// The same ratio by value rather than by count, which is the one the schemes' monitoring
	/// programmes actually threshold on for some merchant categories — and it can move in the
	/// opposite direction to the count when disputes cluster on high-value transactions.
	measure 'Chargeback Volume Rate (bps)' = ```
			DIVIDE(
			    [Disputed Volume (GBP)],
			    [Attempted Volume (GBP)]
			) * 10000
			```
		formatString: #,0.0
		displayFolder: Disputes

	partition fact_dispute = entity
		mode: directLake
		source
			entityName: fact_dispute
			schemaName: dbo
			expressionSource: DatabaseQuery
