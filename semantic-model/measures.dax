// =============================================================================================
// measures.dax — GENERATED. Do not edit this file.
//
// Generated from semantic-model/definition/tables/*.tmdl by tools/extract_dax.py.
// `make lint` runs that script with --check and fails if this file is stale, so the
// TMDL is the one copy that can be edited and this one cannot drift away from it.
//
// This is a complete DAX query: a DEFINE section holding every measure in the model,
// followed by an EVALUATE that returns all of them at the grand total. Pasted into
// DAX query view or Tabular Editor against the deployed model, it is the fastest way
// to find a measure that does not resolve — the error names it. Nothing in this repo
// has executed it; see semantic-model/README.md.
//
// Each measure carries the first paragraph of its TMDL documentation and its format
// string and display folder, as comments. The full reasoning stays in the TMDL beside
// the measure, which is the file to read and the only file to edit.
// =============================================================================================

DEFINE

    // -----------------------------------------------------------------------------------------
    // fact_transaction  (16 measures)
    // -----------------------------------------------------------------------------------------

    // Base measures — the denominators and numerators everything else divides
    //
    // The grain is one authorisation attempt, so the attempt count is a row count. It is a
    // named measure rather than inlined into each rate because it is the denominator of four of
    // them, and a denominator that is defined once is a denominator that cannot drift between
    // measures.
    // [formatString: #,0  ·  displayFolder: Volume]
    MEASURE fact_transaction[Attempts] = COUNTROWS(fact_transaction)

    // [formatString: #,0  ·  displayFolder: Volume]
    MEASURE fact_transaction[Approved Transactions] = SUM(fact_transaction[is_approved])

    // [formatString: #,0  ·  displayFolder: Volume]
    MEASURE fact_transaction[Declined Transactions] = SUM(fact_transaction[is_declined])

    // [formatString: #,0  ·  displayFolder: Volume]
    MEASURE fact_transaction[Reversed Transactions] = SUM(fact_transaction[is_reversed])

    // [formatString: #,0  ·  displayFolder: Volume]
    MEASURE fact_transaction[Settled Transactions] = SUM(fact_transaction[is_settled])

    // Rates — DIVIDE(SUM(numerator), SUM(denominator)), never stored
    //
    // Correct at every grain the user can filter to, which is the property a stored rate does
    // not have. The rule and the failure it prevents are set out in the header of
    // `fact_transaction.tmdl`.
    // [formatString: 0.00%  ·  displayFolder: Rates]
    MEASURE fact_transaction[Authorisation Rate] = DIVIDE([Approved Transactions], [Attempts])

    // [formatString: 0.00%  ·  displayFolder: Rates]
    MEASURE fact_transaction[Decline Rate] = DIVIDE([Declined Transactions], [Attempts])

    // The share of **declines in the current filter context** attributable to the reasons in
    // context — so on a bar chart by `dim_decline_reason[decline_reason_desc]` the bars sum to
    // 100%, and on a card with no reason filter it reads 100%. `ALL` on the dimension rather
    // than `ALLSELECTED` is deliberate: the denominator is every decline in the period, not
    // every decline the user happens to have left in the slicer, so removing a reason from a
    // slicer does not silently rescale the remaining bars.
    // [formatString: 0.00%  ·  displayFolder: Rates]
    MEASURE fact_transaction[Decline Rate by Reason] =
        VAR DeclinesInContext = [Declined Transactions]
        VAR AllDeclines =
            CALCULATE([Declined Transactions], REMOVEFILTERS(dim_decline_reason))
        RETURN
            IF(DeclinesInContext > 0, DIVIDE(DeclinesInContext, AllDeclines))

    // The share of declines that could have been retried, which is the operationally actionable
    // half of a decline rate: an issuer-side "insufficient funds" is not a problem anyone can
    // fix, and a retriable technical decline is.
    // [formatString: 0.00%  ·  displayFolder: Rates]
    MEASURE fact_transaction[Retriable Decline Share] =
        DIVIDE(
            CALCULATE([Declined Transactions], dim_decline_reason[is_retriable] = TRUE),
            [Declined Transactions]
        )

    // Volume — GBP-normalised, via the FX conversion done once in silver
    //
    // `amount_gbp_minor` and never `amount_minor`: a sum of mixed-currency minor units is
    // meaningless. The conversion happened in silver against `dim_fx_rate`'s effective-dated
    // intervals, which is why this model has no FX table and no rate lookup — see
    // `src/warehouse/ddl/02_dimensions.sql`, which says `dim_fx_rate` is there because the fact
    // join needs it "and the semantic model does not".
    // [formatString: \£#,0.00;(\£#,0.00);\£#,0.00  ·  displayFolder: Volume]
    MEASURE fact_transaction[Attempted Volume (GBP)] = SUM(fact_transaction[amount_gbp_minor])

    // [formatString: \£#,0.00;(\£#,0.00);\£#,0.00  ·  displayFolder: Volume]
    MEASURE fact_transaction[Approved Volume (GBP)] =
        CALCULATE(
            SUM(fact_transaction[amount_gbp_minor]),
            fact_transaction[is_approved] = 1
        )

    // [formatString: \£#,0.00;(\£#,0.00);\£#,0.00  ·  displayFolder: Volume]
    MEASURE fact_transaction[Average Approved Value (GBP)] =
        DIVIDE([Approved Volume (GBP)], [Approved Transactions])

    // Settlement
    //
    // Over settled transactions only, because `settlement_lag_days` is NULL on the rest and
    // `AVERAGE` ignores blanks. Deliberately **not** `DIVIDE(SUM(lag), [Attempts])`, which
    // would divide a settled-only numerator by an all-attempts denominator and understate the
    // lag by whatever share is unsettled. It is the only measure on `fact_transaction` where an
    // average is the right shape rather than a ratio of two sums, and the reason is that the
    // denominator is not a stored count.
    // [formatString: #,0.0  ·  displayFolder: Settlement]
    MEASURE fact_transaction[Average Settlement Lag (Days)] =
        AVERAGE(fact_transaction[settlement_lag_days])

    // [formatString: 0.00%  ·  displayFolder: Settlement]
    MEASURE fact_transaction[Settlement Rate] =
        DIVIDE([Settled Transactions], [Approved Transactions])

    // 3DS uplift — the measure most likely to be quoted wrong
    //
    // Expressed in **percentage points**, not as a ratio, because "3DS improves approval by 4%"
    // is ambiguous between +4pp and +4% relative and the two differ by a factor of twenty at
    // these rates. The name says `(pp)` for that reason.
    // [formatString: +0.00;-0.00;0.00  ·  displayFolder: Rates]
    MEASURE fact_transaction[3DS Approval Uplift (pp)] =
        VAR With3DS =
            CALCULATE(
                [Authorisation Rate],
                fact_transaction[channel] = "ECOM",
                fact_transaction[is_3ds] = TRUE
            )
        VAR Without3DS =
            CALCULATE(
                [Authorisation Rate],
                fact_transaction[channel] = "ECOM",
                fact_transaction[is_3ds] = FALSE
            )
        RETURN
            IF(
                NOT ISBLANK(With3DS) && NOT ISBLANK(Without3DS),
                (With3DS - Without3DS) * 100
            )

    // Data quality, surfaced in the report rather than buried in meta_dq_results
    //
    // The share of volume converted at a forward-filled FX rate. A reader who sees `[Attempted
    // Volume (GBP)]` move should be able to tell whether the rates behind it were published or
    // carried, and this is the measure that tells them. It is the serving-layer end of the
    // contract in `docs/data-contracts.md` that the fill be flagged and not silent —
    // `src/lib/dq.py` records the gap in `meta_dq_results`, and this puts the consequence on
    // the same page as the number it affects.
    // [formatString: 0.00%  ·  displayFolder: Data quality]
    MEASURE fact_transaction[FX Carried Share] =
        DIVIDE(
            CALCULATE([Attempts], fact_transaction[fx_rate_is_carried] = TRUE),
            [Attempts]
        )

    // -----------------------------------------------------------------------------------------
    // fact_dispute  (10 measures)
    // -----------------------------------------------------------------------------------------

    // Raised role — the active relationship, so no USERELATIONSHIP needed
    //
    // [formatString: #,0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Disputes Raised] = COUNTROWS(fact_dispute)

    // [formatString: #,0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Disputes Open] = SUM(fact_dispute[is_open])

    // [formatString: #,0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Disputes Won] = SUM(fact_dispute[is_won])

    // [formatString: #,0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Disputes Lost] = SUM(fact_dispute[is_lost])

    // [formatString: \£#,0.00;(\£#,0.00);\£#,0.00  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Disputed Volume (GBP)] = SUM(fact_dispute[disputed_amount_gbp_minor])

    // Won over *decided*, not won over raised. An open dispute has not been lost, and putting
    // it in the denominator reports a win rate that climbs for a month afterwards purely as
    // disputes close — the denominator moving is indistinguishable from performance improving.
    // `is_won + is_lost` is the decided count; withdrawn is excluded from both sides because a
    // withdrawal is not an outcome the disputes team competed for.
    // [formatString: 0.00%  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Dispute Win Rate] =
        DIVIDE(
            [Disputes Won],
            [Disputes Won] + [Disputes Lost]
        )

    // Resolved role — USERELATIONSHIP plus an explicit is_open filter
    //
    // This is the pair `src/warehouse/ddl/04_constraints.sql` promises when it says the two
    // date FKs exist so "the semantic model does the role-playing with two inactive
    // relationships plus USERELATIONSHIP in the measures".
    // [formatString: #,0  ·  displayFolder: Disputes (resolved date)]
    MEASURE fact_dispute[Disputes Resolved] =
        CALCULATE(
            COUNTROWS(fact_dispute),
            USERELATIONSHIP(fact_dispute[resolved_date_sk], dim_date[date_sk]),
            fact_dispute[is_open] = 0
        )

    // Mean days from raised to resolved, attributed to the period the dispute was **resolved**
    // in — which is the operationally useful attribution: it answers "how fast is the team
    // closing things now", whereas the raised-date version answers "how fast were things raised
    // in March eventually closed", a number that is not knowable until the last one closes.
    // [formatString: #,0.0  ·  displayFolder: Disputes (resolved date)]
    MEASURE fact_dispute[Dispute Resolution Days] =
        CALCULATE(
            AVERAGE(fact_dispute[resolution_days]),
            USERELATIONSHIP(fact_dispute[resolved_date_sk], dim_date[date_sk]),
            fact_dispute[is_open] = 0
        )

    // Chargeback rate — in basis points, and the measure that crosses both facts
    //
    // bps rather than a percentage because the honest number is around 5-to-50 per 10,000 and
    // "0.05%" in a table of two-decimal percentages renders as 0.05 next to an authorisation
    // rate of 94.20 — same column, three orders of magnitude apart, and a reader compares them.
    // Payments reports quote chargeback rates in bps for exactly this reason, and the card
    // scheme thresholds that matter (Visa VDMP, Mastercard ECP) are themselves expressed in
    // bps.
    // [formatString: #,0.0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Chargeback Rate (bps)] =
        DIVIDE(
            [Disputes Raised],
            [Attempts]
        ) * 10000

    // The same ratio by value rather than by count, which is the one the schemes' monitoring
    // programmes actually threshold on for some merchant categories — and it can move in the
    // opposite direction to the count when disputes cluster on high-value transactions.
    // [formatString: #,0.0  ·  displayFolder: Disputes]
    MEASURE fact_dispute[Chargeback Volume Rate (bps)] =
        DIVIDE(
            [Disputed Volume (GBP)],
            [Attempted Volume (GBP)]
        ) * 10000

    // -----------------------------------------------------------------------------------------
    // agg_merchant_daily  (6 measures)
    // -----------------------------------------------------------------------------------------

    // The additive measures — the reason this table exists
    //
    // [formatString: #,0  ·  displayFolder: Merchant daily (agg)]
    MEASURE agg_merchant_daily[Attempts (agg)] = SUM(agg_merchant_daily[attempt_count])

    // [formatString: #,0  ·  displayFolder: Merchant daily (agg)]
    MEASURE agg_merchant_daily[Approved (agg)] = SUM(agg_merchant_daily[approved_count])

    // [formatString: \£#,0.00;(\£#,0.00);\£#,0.00  ·  displayFolder: Merchant daily (agg)]
    MEASURE agg_merchant_daily[Attempted Volume (agg, GBP)] =
        SUM(agg_merchant_daily[attempted_amount_gbp_minor])

    // The same DIVIDE-of-two-SUMs shape as on the detail fact, and it gives the same answer at
    // every grain — which is the proof that the rule in
    // `src/warehouse/procs/09_sp_load_agg_merchant_daily.sql` was the right one. Had the proc
    // stored `approval_rate` per merchant-day, this measure could only have been
    // `AVERAGE(approval_rate)`, and `tests/test_gold_recon.py` would not have been able to tie
    // it to the detail fact at any grain above a day.
    // [formatString: 0.00%  ·  displayFolder: Merchant daily (agg)]
    MEASURE agg_merchant_daily[Authorisation Rate (agg)] =
        DIVIDE([Approved (agg)], [Attempts (agg)])

    // The non-additive one, fenced
    //
    // This is the "marked as day-grain-only" the warehouse proc promises. The marking is not a
    // comment or a description — it is a guard that makes the wrong number unobtainable:
    // `HASONEVALUE(dim_date[date_sk])` is true only when the filter context is one day, and the
    // measure returns BLANK otherwise. A monthly card reads blank rather than reading the sum
    // of thirty daily distinct counts, which at this data's shape overstates by roughly an
    // order of magnitude.
    // [formatString: #,0  ·  displayFolder: Merchant daily (agg)]
    MEASURE agg_merchant_daily[Distinct Accounts (per day)] =
        IF(
            HASONEVALUE(dim_date[date_sk]),
            SUM(agg_merchant_daily[distinct_account_count])
        )

    // The correct answer at any grain, and the reason the guard on `[Distinct Accounts (per
    // day)]` can afford to be strict. It goes to the detail fact and counts
    // `dim_account[account_id]` — the **business** key, not `fact_transaction[account_sk]`,
    // which would count SCD2 versions and double-count any account whose risk band moved inside
    // the period. That distinction is invisible at day grain and grows with the window, which
    // makes it exactly the kind of error that survives review.
    // [formatString: #,0  ·  displayFolder: Accounts]
    MEASURE agg_merchant_daily[Distinct Accounts] =
        COUNTROWS(
            SUMMARIZE(fact_transaction, dim_account[account_id])
        )

    // -----------------------------------------------------------------------------------------
    // dim_account  (1 measure)
    // -----------------------------------------------------------------------------------------

    // Counts the *entity*, not the row. See note 1 — this is the measure that exists because
    // `COUNTROWS(dim_account)` would count versions and be silently too high.
    // [formatString: #,0  ·  displayFolder: Accounts]
    MEASURE dim_account[Active Accounts] =
        CALCULATE(
            DISTINCTCOUNT(dim_account[account_id]),
            dim_account[is_current] = TRUE
        )

    // -----------------------------------------------------------------------------------------
    // dim_customer  (1 measure)
    // -----------------------------------------------------------------------------------------

    // [formatString: #,0  ·  displayFolder: Customers]
    MEASURE dim_customer[Active Customers] =
        CALCULATE(
            DISTINCTCOUNT(dim_customer[customer_id]),
            dim_customer[is_current] = TRUE
        )

    // -----------------------------------------------------------------------------------------
    // dim_merchant  (2 measures)
    // -----------------------------------------------------------------------------------------

    // [formatString: #,0  ·  displayFolder: Merchants]
    MEASURE dim_merchant[Active Merchants] =
        CALCULATE(
            DISTINCTCOUNT(dim_merchant[merchant_id]),
            dim_merchant[is_current] = TRUE
        )

    // One row per merchant, not per version — see the note at the top. `AVERAGEX` over the
    // current versions rather than `AVERAGE` over the column.
    // [formatString: #,0.0  ·  displayFolder: Merchants]
    MEASURE dim_merchant[Average Merchant Risk Score] =
        AVERAGEX(
            CALCULATETABLE(VALUES(dim_merchant[merchant_sk]), dim_merchant[is_current] = TRUE),
            CALCULATE(MAX(dim_merchant[risk_score]))
        )


// ---------------------------------------------------------------------------------------------
// Smoke query: every measure above, evaluated with no filter context. A measure that
// returns BLANK here may be correct — several are guarded and are meant to. A measure
// that raises is not.
// ---------------------------------------------------------------------------------------------
EVALUATE
ROW (
    "Attempts", [Attempts],
    "Approved Transactions", [Approved Transactions],
    "Declined Transactions", [Declined Transactions],
    "Reversed Transactions", [Reversed Transactions],
    "Settled Transactions", [Settled Transactions],
    "Authorisation Rate", [Authorisation Rate],
    "Decline Rate", [Decline Rate],
    "Decline Rate by Reason", [Decline Rate by Reason],
    "Retriable Decline Share", [Retriable Decline Share],
    "Attempted Volume (GBP)", [Attempted Volume (GBP)],
    "Approved Volume (GBP)", [Approved Volume (GBP)],
    "Average Approved Value (GBP)", [Average Approved Value (GBP)],
    "Average Settlement Lag (Days)", [Average Settlement Lag (Days)],
    "Settlement Rate", [Settlement Rate],
    "3DS Approval Uplift (pp)", [3DS Approval Uplift (pp)],
    "FX Carried Share", [FX Carried Share],
    "Disputes Raised", [Disputes Raised],
    "Disputes Open", [Disputes Open],
    "Disputes Won", [Disputes Won],
    "Disputes Lost", [Disputes Lost],
    "Disputed Volume (GBP)", [Disputed Volume (GBP)],
    "Dispute Win Rate", [Dispute Win Rate],
    "Disputes Resolved", [Disputes Resolved],
    "Dispute Resolution Days", [Dispute Resolution Days],
    "Chargeback Rate (bps)", [Chargeback Rate (bps)],
    "Chargeback Volume Rate (bps)", [Chargeback Volume Rate (bps)],
    "Attempts (agg)", [Attempts (agg)],
    "Approved (agg)", [Approved (agg)],
    "Attempted Volume (agg, GBP)", [Attempted Volume (agg, GBP)],
    "Authorisation Rate (agg)", [Authorisation Rate (agg)],
    "Distinct Accounts (per day)", [Distinct Accounts (per day)],
    "Distinct Accounts", [Distinct Accounts],
    "Active Accounts", [Active Accounts],
    "Active Customers", [Active Customers],
    "Active Merchants", [Active Merchants],
    "Average Merchant Risk Score", [Average Merchant Risk Score]
)
